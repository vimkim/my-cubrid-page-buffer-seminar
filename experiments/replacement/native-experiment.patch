+/* Experiment-only observation, after page_buffer.c definitions. */
+static thread_local int seminar_request = -1;
+void seminar_trace_event (const char *event, const VPID *vpid)
+{
+  if (seminar_request >= 0 && vpid != NULL)
+    printf ("{\"type\":\"event\",\"request\":%d,\"event\":\"%s\",\"volid\":%d,\"pageid\":%d}\n",
+            seminar_request, event, (int) vpid->volid, vpid->pageid);
+}
+void seminar_begin (int request) { seminar_request = request; }
+void seminar_end () { seminar_request = -1; }
+int seminar_buffers () { return pgbuf_Pool.num_buffers; }
+void seminar_snapshot (THREAD_ENTRY *thread_p, int request)
+{
+  /* Maintenance is frozen; the clean target workload has one caller. */
+  PGBUF_LRU_LIST *lru = PGBUF_GET_LRU_LIST (PGBUF_LRU_INDEX_FROM_PRIVATE (thread_p->private_lru_index));
+  pthread_mutex_lock (&lru->mutex);
+  printf ("{\"type\":\"snapshot\",\"request\":%d,\"buffers\":%d,\"list\":%d,\"quota\":%d,\"zones\":[%d,%d,%d],\"thresholds\":[%d,%d],\"aout\":%d}\n",
+          request, pgbuf_Pool.num_buffers, lru->index, lru->quota,
+          lru->count_lru1, lru->count_lru2, lru->count_lru3,
+          lru->threshold_lru1, lru->threshold_lru2, pgbuf_Pool.buf_AOUT_list.max_count);
+  pthread_mutex_unlock (&lru->mutex);
+}
+
+void seminar_freeze_maintenance (bool freeze)
+{
+  std::lock_guard<std::mutex> guard (seminar_maintenance_mutex);
+  seminar_maintenance_frozen = freeze;
+}
