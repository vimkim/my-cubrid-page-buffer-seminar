+#include "config.h"
+#include "boot_sr.h"
+#include "critical_section.h"
+#include "error_manager.h"
+#include "file_manager.h"
+#include "log_impl.h"
+#include "log_manager.h"
+#include "message_catalog.h"
+#include "page_buffer.h"
+#include "system_parameter.h"
+#include "thread_manager.hpp"
+#include "thread_entry_task.hpp"
+#include "tz_support.h"
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <thread>
+#include <chrono>
+
+// XXX: SHOULD BE THE LAST INCLUDE HEADER
+#include "memory_wrapper.hpp"
+
+extern void seminar_begin (int);
+extern void seminar_end ();
+extern void seminar_snapshot (THREAD_ENTRY *, int);
+extern int seminar_buffers ();
+extern void seminar_freeze_maintenance (bool);
+namespace
+{
+  THREAD_ENTRY *fixture_thread = nullptr;
+
+  bool boot (const char *database)
+  {
+    if (er_init (nullptr, ER_NEVER_EXIT) != NO_ERROR)
+      {
+	return false;
+      }
+    cubthread::initialize (fixture_thread);
+    if (!fixture_thread || msgcat_init () != NO_ERROR || tz_load () != NO_ERROR)
+      {
+	return false;
+      }
+    if (sysprm_load_and_init (database, nullptr, SYSPRM_LOAD_ALL) != NO_ERROR)
+      {
+	return false;
+      }
+    if (sync_initialize_sync_stats () != NO_ERROR || csect_initialize_static_critical_sections () != NO_ERROR)
+      {
+	return false;
+      }
+    CHECK_ARGS checks = {true, true};
+    if (boot_restart_server (fixture_thread, false, database, false, &checks, nullptr, true) != NO_ERROR)
+      {
+	return false;
+      }
+    TRAN_STATE state;
+    return logtb_assign_tran_index (fixture_thread, NULL_TRANID, TRAN_ACTIVE, nullptr, &state,
+				    TRAN_LOCK_INFINITE_WAIT, TRAN_READ_COMMITTED) != NULL_TRAN_INDEX;
+  }
+
+
+  void require (bool ok, const char *what)
+  {
+    if (!ok)
+      {
+	std::fprintf (stderr, "SEMINAR FAILURE: %s (error %d)\n", what, er_errid ());
+	std::abort ();
+      }
+  }
+
+}
+int main (int argc, char **argv)
+{
+  if (argc != 3 || (std::strcmp (argv[2], "fits") && std::strcmp (argv[2], "cycle")))
+    {
+      return 2;
+    }
+  require (boot (argv[1]), "boot");
+  fixture_thread->private_lru_index = pgbuf_assign_private_lru (fixture_thread);
+  pgbuf_thread_variables_init (fixture_thread);
+  require (fixture_thread->private_lru_index >= 0, "private LRU");
+  const int buffers = seminar_buffers ();
+  const int count = std::strcmp (argv[2], "fits") == 0 ? buffers / 2 : buffers + 1;
+  VPID *pages = new VPID[count];
+  VFID file;
+  PAGE_TYPE kind = PAGE_OVERFLOW;
+  require (file_create_with_npages (fixture_thread, FILE_BTREE_OVERFLOW_KEY, count, nullptr, &file) == NO_ERROR, "file");
+  for (int i = 0; i < count; ++i)
+    {
+      PAGE_PTR page = nullptr;
+      require (file_alloc (fixture_thread, &file, file_init_page_type, &kind, &pages[i], &page) == NO_ERROR, "allocate");
+      require (pgbuf_flush_with_wal (fixture_thread, page) != nullptr, "flush initialized page");
+      pgbuf_unfix (fixture_thread, page);
+    }
+  require (pgbuf_flush_all (fixture_thread, NULL_VOLID) == NO_ERROR, "flush setup");
+  // Let normal maintenance observe setup activity, then freeze background scheduling.
+  BO_ENABLE_FLUSH_DAEMONS ();
+  std::this_thread::sleep_for (std::chrono::milliseconds (600));
+  seminar_freeze_maintenance (true);
+  require (pgbuf_invalidate_all (fixture_thread, NULL_VOLID) == NO_ERROR, "cold buffer");
+  std::printf ("{\"type\":\"setup\",\"scenario\":\"%s\",\"buffers\":%d,\"pages\":%d,\"passes\":3,\"page_buffer_daemons\":\"maintenance-frozen-flushers-live\"}\n",
+	       argv[2], buffers, count);
+  seminar_snapshot (fixture_thread, -1);
+  for (int pass = 0; pass < 3; ++pass)
+    for (int i = 0; i < count; ++i)
+      {
+	int request = pass * count + i;
+	std::printf ("{\"type\":\"request\",\"request\":%d,\"pass\":%d,\"index\":%d,\"volid\":%d,\"pageid\":%d}\n", request,
+		     pass, i, (int) pages[i].volid, pages[i].pageid);
+	seminar_begin (request);
+	PAGE_PTR page = pgbuf_fix (fixture_thread, &pages[i], OLD_PAGE, PGBUF_LATCH_READ, PGBUF_UNCONDITIONAL_LATCH);
+	require (page != nullptr, "read fix");
+	pgbuf_unfix (fixture_thread, page);
+	seminar_end ();
+	seminar_snapshot (fixture_thread, request);
+      }
+  std::fflush (stdout);
+  // Resume ordinary maintenance before rollback and shutdown.
+  seminar_freeze_maintenance (false);
+  delete [] pages;
+  int transaction = fixture_thread->tran_index;
+  log_abort (fixture_thread, transaction);
+  pgbuf_release_private_lru (fixture_thread, fixture_thread->private_lru_index);
+  logtb_release_tran_index (fixture_thread, transaction);
+  xboot_shutdown_server (fixture_thread, ER_THREAD_FINAL);
+  return 0;
+}
